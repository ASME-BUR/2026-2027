<!--
  The full target mission. NOTE: it FAILS ON ITS FIRST TICK. HoldDepth and
  Surface are registered placeholders, because depth is deferred (D-3 / C-8 /
  F-4), and they always return FAILURE. Do not launch this tree expecting a
  mission. Launch fish_tree_horizontal.xml, which is the same gate task
  without the depth steps.

  It must still LOAD: test/test_tree_loading.cpp checks every top-level XML
  here against the real factory (A-3).

  There is no GoToPose. To reach a point the vehicle turns (TurnToHeading)
  and then swims (SwimForward), because it cannot strafe and cannot hold
  station without swimming.

  Rules for every tree in this directory:
    - no Parallel node over action leaves (only one leaf may write the swim
      command per tick)
    - no blackboard {keys}. Settings come from the manager's parameters
      through the MissionContext. Each SubTree has its own isolated blackboard
      in BT.CPP v4, so a key set at the root is invisible inside GateTask.
    - GateTask uses a plain Sequence, NOT SequenceWithMemory. On FAILURE a
      Sequence restarts from its first child, so a retry after a lost
      detection searches again. SequenceWithMemory would resume at the
      failed turn.
-->
<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <SequenceWithMemory>
            <!-- deferred placeholder: fails (D-3 / C-8) -->
            <HoldDepth depth_m="-1.0" tolerance_m="0.2" timeout_s="20.0"/>

            <RetryUntilSuccessful num_attempts="3">
                <SubTree ID="GateTask"/>
            </RetryUntilSuccessful>

            <!-- deferred placeholder: fails (F-4, D-3 / C-8) -->
            <Surface/>
        </SequenceWithMemory>
    </BehaviorTree>

    <BehaviorTree ID="GateTask">
        <Sequence>
            <!-- look for it before committing to a heading -->
            <Fallback>
                <IsDetected label="0"/>
                <SearchPattern label="0" sweep_rad="1.57" timeout_s="30.0"/>
            </Fallback>

            <TurnToHeading source="detection" label="0" tolerance_rad="0.15"/>
            <SwimForward distance_m="4.0" speed_mps="0.3"/>
        </Sequence>
    </BehaviorTree>
</root>
