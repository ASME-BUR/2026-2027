<!--
  The mission launched now: the gate task in the horizontal plane only (surge +
  yaw), the current focus in DEVELOPMENT.md. It is fish_tree.xml without the
  deferred depth steps (HoldDepth / Surface, D-3 / C-8 / F-4).

  The same rules apply as in fish_tree.xml: no Parallel over action leaves,
  no blackboard {keys}, and a plain Sequence in GateTask so a retry searches
  again.

  SwimForward has no `mode` attribute on purpose. It takes the manager's
  swim_forward_mode parameter: `timed` on the vehicle until P-3 makes odometry
  x/y trustworthy, `odometry` on the bench.
-->
<root BTCPP_format="4">
    <BehaviorTree ID="MainTree">
        <RetryUntilSuccessful num_attempts="3">
            <SubTree ID="GateTask"/>
        </RetryUntilSuccessful>
    </BehaviorTree>

    <BehaviorTree ID="GateTask">
        <Sequence>
            <Fallback>
                <IsDetected label="0"/>
                <SearchPattern label="0" sweep_rad="1.57" timeout_s="30.0"/>
            </Fallback>

            <TurnToHeading source="detection" label="0" tolerance_rad="0.15"/>
            <SwimForward distance_m="4.0" speed_mps="0.3"/>
        </Sequence>
    </BehaviorTree>
</root>
