<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bur_autonomy</name>
  <version>0.0.0</version>
  <description>Mission manager: a BehaviorTree.CPP v4 tree that publishes SwimCommand. See PLAN.md.</description>
  <maintainer email="bur.asmebruins@gmail.com">buruser</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- No nav2 (D-7): CMakeLists.txt rejects it. -->
  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>bur_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
